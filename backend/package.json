{
  "name": "backend",
  "version": "1.0.0",
  "description": "FloodLens API: routing, flood-risk scoring, live intelligence and community reports",
  "main": "index.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:local": "node scripts/local-db.mjs"
  },
