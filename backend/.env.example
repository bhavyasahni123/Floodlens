# FloodLens backend configuration. Copy to .env and adjust. Never commit .env.
PORT=5000

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Set to true only when the API sits behind exactly one proxy (e.g. CloudFront),
# so rate limits and report checks see each visitor's real IP. Leave false locally.
TRUST_PROXY=false

# PostgreSQL connection for community reports. Leave empty to run without reports.
# Local system install example:  postgres://postgres:YOUR_PASSWORD@localhost:5432/floodlens
# `npm run db:local` example:     postgres://postgres:floodlens_local@localhost:5433/floodlens
DATABASE_URL=

# Secret used to hash submitter IPs (only to judge report independence). Use a long random value.
REPORT_HASH_SECRET=change-me-to-a-long-random-string

# Community report policy (defaults shown).
REPORT_EXPIRY_HOURS=3
CLUSTER_RADIUS_METERS=100
CLUSTER_WINDOW_HOURS=2
CLUSTER_MIN_REPORTS=2
REPORT_RATE_LIMIT=5
REPORT_RATE_WINDOW_MINUTES=10

# Optional provider overrides (defaults are the free public services).
# OSRM_DRIVING_URL=https://router.project-osrm.org/route/v1/driving
# OSRM_WALKING_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot
# OSRM_CYCLING_URL=https://routing.openstreetmap.de/routed-bike/route/v1/bike
# HTTP_USER_AGENT=FloodLensPrototype/1.0 (contact: you@example.com)
